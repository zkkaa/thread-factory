import { describe, expect, it } from 'vitest';
import { level1_1 } from '../../levels/module1/level-1-1';
import {
  applyTools,
  applyToolsDetailed,
  type PlacedTool,
} from '../tools';

const mutexTool: PlacedTool = {
  id: 't1',
  kind: 'mutex',
  mutex: 'papan',
  spans: [
    { thread: 'A', start: 1, end: 3 },
    { thread: 'B', start: 1, end: 3 },
  ],
};

describe('applyToolsDetailed', () => {
  it('tanpa alat: semua instruksi berasal dari program asli', () => {
    const { origins } = applyToolsDetailed(level1_1.threads, []);
    expect(origins['A']).toEqual([
      { kind: 'original', index: 0 },
      { kind: 'original', index: 1 },
      { kind: 'original', index: 2 },
      { kind: 'original', index: 3 },
    ]);
  });

  it('mutex 1..3: LOCK di slot 1, UNLOCK di slot 4', () => {
    const { origins } = applyToolsDetailed(level1_1.threads, [mutexTool]);
    expect(origins['A']).toEqual([
      { kind: 'original', index: 0 },
      { kind: 'inserted', op: 'LOCK', slot: 1 },
      { kind: 'original', index: 1 },
      { kind: 'original', index: 2 },
      { kind: 'original', index: 3 },
      { kind: 'inserted', op: 'UNLOCK', slot: 4 },
    ]);
  });

  it('panjang peta asal sama dengan panjang program efektif', () => {
    const { threads, origins } = applyToolsDetailed(level1_1.threads, [
      mutexTool,
    ]);
    for (const thread of threads) {
      expect(origins[thread.id]?.length).toBe(thread.program.length);
    }
  });

  it('pintu yang menutupi WORK: LOCK di slot 0', () => {
    const tool: PlacedTool = {
      ...mutexTool,
      spans: [{ thread: 'A', start: 0, end: 3 }],
    };
    const { origins } = applyToolsDetailed(level1_1.threads, [tool]);
    expect(origins['A']?.[0]).toEqual({
      kind: 'inserted',
      op: 'LOCK',
      slot: 0,
    });
  });

  it('tidak mengubah masukan, dan applyTools sama dengan .threads', () => {
    const before = JSON.stringify(level1_1.threads);
    const detailed = applyToolsDetailed(level1_1.threads, [mutexTool]);
    expect(JSON.stringify(level1_1.threads)).toBe(before);
    expect(applyTools(level1_1.threads, [mutexTool])).toEqual(
      detailed.threads,
    );
  });
});